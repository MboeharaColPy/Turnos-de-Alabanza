rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Administrador verificado por Firestore o cuenta principal bootstrapped
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'jairoandrodriguezlo@gmail.com'
      );
    }

    // Estado compartido de la app (shared_data/main) y su respaldo (shared_data/backup_latest):
    // Lectura y escritura permitidas para que canciones, setlists y turnos se sincronicen en vivo sin bloqueos de permisos
    match /shared_data/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Registro y verificación de administradores
    match /admins/{uid} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.email == 'jairoandrodriguezlo@gmail.com' ||
        request.auth.uid == uid
      );
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

